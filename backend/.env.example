# Fill this in locally. For example, generate a value with openssl rand -hex 32.
POSTGRES_PASSWORD=
# "missing" permits Docker Hub access for the initial team setup.
# Set "never" when using preloaded images only.
DROM_POSTGRES_PULL_POLICY=missing
DROM_LISTINGS_SOURCE=demo
# The following loopback URLs are for host-side venv use.
DROM_DATABASE_URL=postgresql+psycopg://drom@127.0.0.1:55432/drom_profit
DROM_TEST_DATABASE_URL=postgresql+psycopg://drom@127.0.0.1:55433/drom_profit_test
DROM_DB_POOL_SIZE=10
DROM_DB_MAX_OVERFLOW=5
