# In development the default is mock. Production defaults to real.
VITE_API_MODE=mock
# Leave empty to use the current origin in mock mode.
# Local real mode: set VITE_API_MODE=real and VITE_API_BASE_URL=http://127.0.0.1:8000.
VITE_API_BASE_URL=
# Only used in mock mode: empty, seeded, showcase or list-error.
VITE_MOCK_SCENARIO=empty
