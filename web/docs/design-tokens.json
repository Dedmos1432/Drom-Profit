  "component": {
    "button": {
      "height": { "$type": "dimension", "$value": "{sizing.control}" },
      "heightTouch": { "$type": "dimension", "$value": "{sizing.touchTarget}" },
      "heightLarge": { "$type": "dimension", "$value": "{sizing.controlLarge}" },
      "paddingInline": { "$type": "dimension", "$value": "{spacing.panel}" },
      "radius": { "$type": "dimension", "$value": "{radius.control}" },
      "iconGap": { "$type": "dimension", "$value": "{spacing.tiny}" }
    },
    "field": {
      "height": { "$type": "dimension", "$value": "{sizing.control}" },
      "heightTouch": { "$type": "dimension", "$value": "{sizing.touchTarget}" },
      "paddingInline": { "$type": "dimension", "$value": "{spacing.field}" },
      "radius": { "$type": "dimension", "$value": "{radius.control}" },
      "textareaMinHeight": { "$type": "dimension", "$value": "100px" }
    },
    "choice": {
      "mark": { "$type": "dimension", "$value": "{sizing.choiceMark}" },
      "gap": { "$type": "dimension", "$value": "{spacing.small}" }
    },
    "header": {
      "minHeight": { "$type": "dimension", "$value": "{sizing.controlLarge}" },
      "gap": { "$type": "dimension", "$value": "{spacing.row}" }
    },
    "card": {
      "padding": { "$type": "dimension", "$value": "{spacing.panel}" },
      "paddingCompact": { "$type": "dimension", "$value": "{spacing.row}" },
      "gap": { "$type": "dimension", "$value": "{spacing.row}" },
      "radius": { "$type": "dimension", "$value": "{radius.panel}" }
