  "typography": {
    "family": {
      "ui": { "$type": "fontFamily", "$value": "system-ui, Arial, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
