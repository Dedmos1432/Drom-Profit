{
  "$meta": {
    "name": "Drom Profit Web",
    "status": "draft",
    "classification": "Proposed",
    "audit": "DROM_VISUAL_AUDIT.md",
    "mode": "light",
    "format": "Leaf tokens have $type and $value. Whole-value aliases refer to dot-separated token paths."
  },
  "color": {
    "palette": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "ink": { "$type": "color", "$value": "#20262D" },
      "mutedInk": { "$type": "color", "$value": "#526171" },
      "pageGray": { "$type": "color", "$value": "#F6F7F9" },
      "softGray": { "$type": "color", "$value": "#EEF1F4" },
      "pressedGray": { "$type": "color", "$value": "#E3E8EE" },
      "lineGray": { "$type": "color", "$value": "#DBE1E8" },
      "controlGray": { "$type": "color", "$value": "#7C8998" },
      "red": { "$type": "color", "$value": "#B42333" },
      "redStrong": { "$type": "color", "$value": "#981C2A" },
      "redPressed": { "$type": "color", "$value": "#7C1924" },
      "redSoft": { "$type": "color", "$value": "#FBECEF" },
      "blue": { "$type": "color", "$value": "#185B99" },
      "blueStrong": { "$type": "color", "$value": "#124478" },
      "blueFocus": { "$type": "color", "$value": "#245FA5" },
      "blueSoft": { "$type": "color", "$value": "#EAF2FB" },
      "green": { "$type": "color", "$value": "#266245" },
      "greenSoft": { "$type": "color", "$value": "#EAF5EF" },
      "amber": { "$type": "color", "$value": "#724407" },
      "amberSoft": { "$type": "color", "$value": "#FFF4D9" },
      "veil": { "$type": "color", "$value": "rgba(32, 38, 45, 0.48)" }
    },
    "semantic": {
      "background": {
        "page": { "$type": "color", "$value": "{color.palette.pageGray}" },
        "surface": { "$type": "color", "$value": "{color.palette.white}" },
        "subtle": { "$type": "color", "$value": "{color.palette.softGray}" },
        "hover": { "$type": "color", "$value": "{color.palette.softGray}" },
        "pressed": { "$type": "color", "$value": "{color.palette.pressedGray}" },
        "overlay": { "$type": "color", "$value": "{color.palette.veil}" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "{color.palette.ink}" },
        "secondary": { "$type": "color", "$value": "{color.palette.mutedInk}" },
        "muted": { "$type": "color", "$value": "{color.palette.mutedInk}" },
        "placeholder": { "$type": "color", "$value": "{color.palette.mutedInk}" },
        "disabled": { "$type": "color", "$value": "{color.palette.mutedInk}" },
        "inverse": { "$type": "color", "$value": "{color.palette.white}" },
        "link": { "$type": "color", "$value": "{color.palette.blue}" },
        "linkHover": { "$type": "color", "$value": "{color.palette.blueStrong}" }
      },
      "border": {
        "divider": { "$type": "color", "$value": "{color.palette.lineGray}" },
        "control": { "$type": "color", "$value": "{color.palette.controlGray}" }
      },
      "action": {
        "primary": { "$type": "color", "$value": "{color.palette.red}" },
        "primaryHover": { "$type": "color", "$value": "{color.palette.redStrong}" },
        "primaryPressed": { "$type": "color", "$value": "{color.palette.redPressed}" },
        "secondary": { "$type": "color", "$value": "{color.palette.white}" },
        "disabled": { "$type": "color", "$value": "{color.palette.softGray}" },
        "focus": { "$type": "color", "$value": "{color.palette.blueFocus}" },
        "selectedSurface": { "$type": "color", "$value": "{color.palette.redSoft}" },
        "selectedText": { "$type": "color", "$value": "{color.palette.redStrong}" }
      },
      "status": {
        "infoText": { "$type": "color", "$value": "{color.palette.blueStrong}" },
        "infoSurface": { "$type": "color", "$value": "{color.palette.blueSoft}" },
        "successText": { "$type": "color", "$value": "{color.palette.green}" },
        "successSurface": { "$type": "color", "$value": "{color.palette.greenSoft}" },
        "warningText": { "$type": "color", "$value": "{color.palette.amber}" },
        "warningSurface": { "$type": "color", "$value": "{color.palette.amberSoft}" },
        "errorText": { "$type": "color", "$value": "{color.palette.redStrong}" },
        "errorSurface": { "$type": "color", "$value": "{color.palette.redSoft}" }
      }
    }
  },
  "typography": {
    "family": {
      "ui": { "$type": "fontFamily", "$value": "system-ui, Arial, 'Segoe UI', sans-serif" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "caption": { "$type": "dimension", "$value": "13px" },
      "compact": { "$type": "dimension", "$value": "14px" },
      "body": { "$type": "dimension", "$value": "15px" },
      "controlMobile": { "$type": "dimension", "$value": "16px" },
      "cardTitle": { "$type": "dimension", "$value": "18px" },
      "section": { "$type": "dimension", "$value": "22px" },
      "pageCompact": { "$type": "dimension", "$value": "28px" },
      "page": { "$type": "dimension", "$value": "34px" },
      "amount": { "$type": "dimension", "$value": "30px" }
    },
    "lineHeight": {
      "caption": { "$type": "dimension", "$value": "18px" },
      "compact": { "$type": "dimension", "$value": "20px" },
      "body": { "$type": "dimension", "$value": "23px" },
      "controlMobile": { "$type": "dimension", "$value": "24px" },
      "cardTitle": { "$type": "dimension", "$value": "24px" },
      "section": { "$type": "dimension", "$value": "29px" },
      "pageCompact": { "$type": "dimension", "$value": "36px" },
      "page": { "$type": "dimension", "$value": "43px" },
      "amount": { "$type": "dimension", "$value": "38px" }
    },
    "letterSpacing": {
      "default": { "$type": "keyword", "$value": "normal" }
    },
    "numeric": {
      "money": { "$type": "keyword", "$value": "tabular-nums lining-nums" }
    }
  },
  "spacing": {
    "hairline": { "$type": "dimension", "$value": "2px" },
    "tiny": { "$type": "dimension", "$value": "5px" },
    "small": { "$type": "dimension", "$value": "10px" },
    "field": { "$type": "dimension", "$value": "12px" },
    "row": { "$type": "dimension", "$value": "15px" },
    "panel": { "$type": "dimension", "$value": "20px" },
    "roomy": { "$type": "dimension", "$value": "24px" },
    "section": { "$type": "dimension", "$value": "30px" },
    "major": { "$type": "dimension", "$value": "40px" }
  },
  "sizing": {
    "control": { "$type": "dimension", "$value": "40px" },
    "controlLarge": { "$type": "dimension", "$value": "50px" },
    "touchTarget": { "$type": "dimension", "$value": "44px" },
    "choiceMark": { "$type": "dimension", "$value": "22px" },
    "thumbnailAspect": { "$type": "ratio", "$value": "4 / 3" },
    "listingThumb": { "$type": "dimension", "$value": "160px" },
    "compactThumb": { "$type": "dimension", "$value": "96px" }
  },
  "radius": {
    "mark": { "$type": "dimension", "$value": "6px" },
    "control": { "$type": "dimension", "$value": "10px" },
    "image": { "$type": "dimension", "$value": "12px" },
    "panel": { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "border": {
    "thin": { "$type": "dimension", "$value": "1px" },
    "emphasis": { "$type": "dimension", "$value": "2px" },
    "focusOffset": { "$type": "dimension", "$value": "2px" }
  },
  "shadow": {
    "flat": { "$type": "shadow", "$value": "none" },
    "overlay": { "$type": "shadow", "$value": "0 10px 28px rgba(32, 38, 45, 0.16), 0 2px 6px rgba(32, 38, 45, 0.08)" }
  },
  "layout": {
    "containerMax": { "$type": "dimension", "$value": "1120px" },
    "formMax": { "$type": "dimension", "$value": "640px" },
    "dialogMax": { "$type": "dimension", "$value": "480px" },
    "gutterCompact": { "$type": "dimension", "$value": "16px" },
    "gutterMedium": { "$type": "dimension", "$value": "{spacing.roomy}" },
    "gutterWide": { "$type": "dimension", "$value": "32px" },
    "detailColumns": { "$type": "gridTemplate", "$value": "minmax(0, 3fr) minmax(300px, 2fr)" },
    "comparisonLabelMin": { "$type": "dimension", "$value": "136px" },
    "comparisonVehicleMin": { "$type": "dimension", "$value": "152px" }
  },
  "breakpoint": {
    "medium": { "$type": "dimension", "$value": "600px" },
    "wide": { "$type": "dimension", "$value": "900px" },
    "large": { "$type": "dimension", "$value": "1200px" }
  },
  "icon": {
    "small": { "$type": "dimension", "$value": "16px" },
    "default": { "$type": "dimension", "$value": "20px" },
    "large": { "$type": "dimension", "$value": "24px" },
    "stroke": { "$type": "dimension", "$value": "2px" }
  },
  "motion": {
    "feedback": { "$type": "duration", "$value": "150ms" },
    "reduced": { "$type": "duration", "$value": "0ms" },
    "easing": { "$type": "cubicBezier", "$value": "ease-out" }
  },
  "component": {
    "button": {
      "height": { "$type": "dimension", "$value": "{sizing.control}" },
      "heightTouch": { "$type": "dimension", "$value": "{sizing.touchTarget}" },
      "heightLarge": { "$type": "dimension", "$value": "{sizing.controlLarge}" },
      "paddingInline": { "$type": "dimension", "$value": "{spacing.panel}" },
      "radius": { "$type": "dimension", "$value": "{radius.control}" },
      "iconGap": { "$type": "dimension", "$value": "{spacing.tiny}" }
    },
    "field": {
      "height": { "$type": "dimension", "$value": "{sizing.control}" },
      "heightTouch": { "$type": "dimension", "$value": "{sizing.touchTarget}" },
      "paddingInline": { "$type": "dimension", "$value": "{spacing.field}" },
      "radius": { "$type": "dimension", "$value": "{radius.control}" },
      "textareaMinHeight": { "$type": "dimension", "$value": "100px" }
    },
    "choice": {
      "mark": { "$type": "dimension", "$value": "{sizing.choiceMark}" },
      "gap": { "$type": "dimension", "$value": "{spacing.small}" }
    },
    "header": {
      "minHeight": { "$type": "dimension", "$value": "{sizing.controlLarge}" },
      "gap": { "$type": "dimension", "$value": "{spacing.row}" }
    },
    "card": {
      "padding": { "$type": "dimension", "$value": "{spacing.panel}" },
      "paddingCompact": { "$type": "dimension", "$value": "{spacing.row}" },
      "gap": { "$type": "dimension", "$value": "{spacing.row}" },
      "radius": { "$type": "dimension", "$value": "{radius.panel}" }
    },
    "badge": {
      "paddingBlock": { "$type": "dimension", "$value": "{spacing.tiny}" },
      "paddingInline": { "$type": "dimension", "$value": "{spacing.small}" },
      "radius": { "$type": "dimension", "$value": "{radius.pill}" }
    },
    "alert": {
      "padding": { "$type": "dimension", "$value": "{spacing.row}" },
      "gap": { "$type": "dimension", "$value": "{spacing.small}" },
      "radius": { "$type": "dimension", "$value": "{radius.control}" }
    },
    "table": {
      "cellPaddingBlock": { "$type": "dimension", "$value": "{spacing.small}" },
      "cellPaddingInline": { "$type": "dimension", "$value": "{spacing.field}" }
    }
  }
}
